; Headless checks: the parser, the cascade, the converter and the app,
; driven without a window.
Import "../src/BrowserApp.rgr"

class BrowserCheck {
    def fails:int 0
    def passes:int 0

    fn check:void (name:string ok:boolean) {
        if ok {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL: " + name)
        }
    }

    sfn main:void () {
        def c (new BrowserCheck())
        c.run()
    }

    ; The first <p> of a styled document, at a viewport width.
    fn styledP:HNode (html:string width:double) {
        def pg (new BrPage())
        pg.load((BrUrl.parse("https://example.com/")) html (new SafetyPolicy()))
        pg.restyle(width 700.0)
        def found@(optional):HNode (pg.doc.find("p"))
        return (unwrap found)
    }

    fn colorOf:string (html:string width:double) {
        def p:HNode (this.styledP(html width))
        return (HtmlToEvg.prop(p.style "color" ""))
    }

    fn cascadeChecks:void () {
        this.check("id beats type" ((this.colorOf("<style>#a p { color: red } p { color: blue }</style><div id=a><p>x</p></div>" 900.0)) == "red"))
        this.check("later wins" ((this.colorOf("<style>p { color: red } p { color: blue }</style><p>x</p>" 900.0)) == "blue"))
        this.check("class beats type" ((this.colorOf("<style>.k { color: green } p { color: blue }</style><p class=k>x</p>" 900.0)) == "green"))
        this.check("important" ((this.colorOf("<style>p { color: red !important } .k { color: blue }</style><p class=k>x</p>" 900.0)) == "red"))
        this.check("inline style" ((this.colorOf("<style>p { color: red }</style><p style='color: teal'>x</p>" 900.0)) == "teal"))
        this.check("child combinator" ((this.colorOf("<style>div > p { color: red } p { color: blue }</style><div><span><p>x</p></span></div>" 900.0)) == "blue"))
        this.check("inherited" ((this.colorOf("<style>body { color: purple }</style><p>x</p>" 900.0)) == "purple"))
        this.check("custom property" ((this.colorOf("<style>:root { --ink: #123456 } p { color: var(--ink) }</style><p>x</p>" 900.0)) == "#123456"))
        this.check("var fallback" ((this.colorOf("<style>p { color: var(--nope, olive) }</style><p>x</p>" 900.0)) == "olive"))
        this.check("media narrow" ((this.colorOf("<style>p { color: red } @media (max-width: 600px) { p { color: blue } }</style><p>x</p>" 500.0)) == "blue"))
        this.check("media wide" ((this.colorOf("<style>p { color: red } @media (max-width: 600px) { p { color: blue } }</style><p>x</p>" 900.0)) == "red"))
        this.check("attribute selector" ((this.colorOf("<style>p[data-x=\"1\"] { color: red }</style><p data-x=1>x</p>" 900.0)) == "red"))
        this.check("not()" ((this.colorOf("<style>p:not(.k) { color: red }</style><p class=k>x</p>" 900.0)) != "red"))
        def p1:HNode (this.styledP("<style>p { margin: 1px 2px 3px 4px; font-size: 2em }</style><p>x</p>" 900.0))
        this.check("margin shorthand" ((HtmlToEvg.prop(p1.style "margin-left" "")) == "4px"))
        this.check("em font size" ((HtmlToEvg.prop(p1.style "font-size" "")) == "34px"))
    }

    fn formCheck:void () {
        def app (new BrowserApp())
        app.setPageSize(900.0 700.0)
        app.start("about:demo")
        app.frameJson()
        def fid:string ""
        for app.page.converter.fields f:BrField i {
            if (f.kind == "search") {
                fid = f.id
            }
        }
        this.check("search field found" ((strlen fid) > 0))
        app.setFocus(fid)
        app.setFieldValue(fid "aurinko")
        app.keyWith("Enter" false false)
        def req:string (app.nextRequest())
        this.check("form submits with GET" (endsWith req "https://fi.wikipedia.org/w/index.php?search=aurinko"))
        ; a fixed banner is not drawn
        def pg (new BrPage())
        pg.load((BrUrl.parse("https://example.com/")) "<div style='position: fixed'>MAINOS</div><p>teksti</p>" (new SafetyPolicy()))
        pg.restyle(900.0 700.0)
        def root:EVGElement (pg.render(900.0 700.0 (new SafetyPolicy())))
        def dl (new EVGDisplayList())
        def lay (new EVGLayout())
        lay.setPageSize(900.0 700.0)
        lay.layout(root)
        dl.setTextEngine((lay.getTextEngine()))
        dl.build(root)
        def json:string (dl.toJson())
        this.check("fixed banner hidden" (((indexOf json "MAINOS") < 0) && ((indexOf json "teksti") >= 0)))
    }

    fn run:void () {
        def app (new BrowserApp())
        app.setPageSize(900.0 700.0)
        app.start("about:home")
        def json:string (app.frameJson())
        this.check("home renders" ((strlen json) > 1000))
        this.check("home has links" ((app.linkCount()) > 5))
        print ("home: links=" + (to_string (app.linkCount())) + " height=" + (to_string (app.contentHeight())) + " title=" + (app.pageTitle()))
        app.navigate("about:demo")
        app.frameJson()
        this.check("demo renders" ((app.contentHeight()) > 700.0))
        ; an in-page link scrolls and does not leave the page
        def anchor:string (app.linkIdFor("about:demo#taulukko"))
        this.check("anchor link resolved" ((strlen anchor) > 0))
        app.press(anchor)
        this.check("anchor scrolls" (((app.scrollPosition()) > 200.0) && ((app.currentUrl()) == "about:demo")))
        this.check("anchor fetches nothing" ((app.pendingRequests()) == 0))
        print ("demo: links=" + (to_string (app.linkCount())) + " height=" + (to_string (app.contentHeight())))
        ; a blocked site
        app.navigate("https://evil.example/")
        this.check("blocked page shown" ((app.currentUrl()) == "about:blocked"))
        this.check("nothing fetched for a blocked site" ((app.pendingRequests()) == 0))
        ; an allowed site: a request goes out
        app.navigate("https://yle.fi/uutiset")
        def req:string (app.nextRequest())
        this.check("yle requested" (endsWith req "\tpage\thttps://yle.fi/uutiset"))
        def id:int (unwrap (str2int (itemAt (strsplit req "\t") 0)))
        app.deliver(id 200 "https://yle.fi/uutiset" "text/html; charset=utf-8" "<html><head><title>Uutiset</title><link rel=stylesheet href=/a.css><style>.lead{font-size:22px}</style></head><body><h1 class=lead>Otsikko</h1><p>Teksti <a href='/uutiset/3-1'>linkki</a></p><img src='https://images.cdn.yle.fi/x.jpg' alt='Kuva'></body></html>")
        def cssReq:string (app.nextRequest())
        this.check("css requested" (endsWith cssReq "\tcss\thttps://yle.fi/a.css"))
        def cid:int (unwrap (str2int (itemAt (strsplit cssReq "\t") 0)))
        app.deliver(cid 200 "https://yle.fi/a.css" "text/css" "body { background-color: #fafafa } h1 { color: #003366 } @media (max-width: 600px) { h1 { color: red } }")
        this.check("title" ((app.pageTitle()) == "Uutiset"))
        def imgReq:string (app.nextRequest())
        this.check("image requested" (endsWith imgReq "\timage\thttps://images.cdn.yle.fi/x.jpg"))
        if ((endsWith imgReq "x.jpg") == false) {
            print ("  got: [" + imgReq + "]")
        }
        app.imageLoaded("https://images.cdn.yle.fi/x.jpg" 1200.0 800.0)
        app.tick(300.0)
        def j2:string (app.frameJson())
        this.check("image drawn" ((indexOf j2 "images.cdn.yle.fi/x.jpg") >= 0))
        def lid:string (app.linkIdFor("https://yle.fi/uutiset/3-1"))
        this.check("link resolved" ((strlen lid) > 0))
        app.press(lid)
        def next:string (app.nextRequest())
        this.check("link followed" (endsWith next "https://yle.fi/uutiset/3-1"))
        app.back()
        this.check("back re-requests" (endsWith (app.nextRequest()) "https://yle.fi/uutiset"))
        ; address bar search
        this.check("search" ((BrowserApp.addressFor("kissa koira")) == "https://fi.wikipedia.org/w/index.php?search=kissa+koira"))
        this.check("bare host" ((BrowserApp.addressFor("yle.fi")) == "https://yle.fi/"))
        this.cascadeChecks()
        this.formCheck()
        print ("passed " + (to_string passes) + ", failed " + (to_string fails))
    }
}
