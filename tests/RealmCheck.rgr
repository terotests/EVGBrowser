; SPDX-License-Identifier: AGPL-3.0-or-later
; The script realm, driven in-process as a host drives it: the browser's
; requests go to a PageRealm, its answers come back, and the page the
; browser shows must be what the scripts made of it. React 18 comes from
; RangerDOM's tests (vendor/ranger/rangerdom/tests/react).
Import "../src/js/PageRealm.rgr"
Import "../src/BrowserApp.rgr"

class RealmCheck {
    def fails:int 0
    def passes:int 0
    def realm:PageRealm (new PageRealm())
    def realmJob:int -1

    fn check:void (name:string ok:boolean) {
        if ok {
            passes = (passes + 1)
        } {
            fails = (fails + 1)
            print ("FAIL: " + name)
        }
    }

    ; What the host does each frame: requests to the realm, answers back.
    fn drive:void (app:BrowserApp) {
        def guard:int 0
        while ((app.realmJobPending()) && (guard < 20)) {
            def job:int (app.takeRealmJob())
            if (app.realmRequestIsStart()) {
                realm = (new PageRealm())
            }
            realmJob = job
            app.realmResult(job (realm.handle((app.realmRequest()))))
            guard = (guard + 1)
        }
    }

    ; The first queued request: [id, kind, url].
    fn nextReq:[string] (app:BrowserApp) {
        def r:string (app.nextRequest())
        return (strsplit r "\t")
    }

    fn reqId:int (r:[string]) {
        return (unwrap (str2int (itemAt r 0)))
    }

    ; A browser showing `html` from https://example.com/a/, its scripts run.
    fn open:BrowserApp (html:string) {
        def app (new BrowserApp())
        app.setPageSize(900.0 700.0)
        app.navigate("https://example.com/a/")
        def r:[string] (this.nextReq(app))
        app.deliver((this.reqId(r)) 200 "https://example.com/a/" "text/html" html)
        this.drive(app)
        return app
    }

    fn bodyText:string (app:BrowserApp) {
        def b@(optional):HNode (app.page.doc.find("body"))
        if (null? b) {
            return ""
        }
        def bn:HNode (unwrap b)
        return (HtmlParser.collapseSpace((this.visible(bn))))
    }

    fn visible:string (n:HNode) {
        if n.isText {
            return n.text
        }
        if ((n.tag == "script") || (n.tag == "style")) {
            return ""
        }
        def out:string ""
        for n.children c:HNode i {
            out = (out + (this.visible(c)))
        }
        return out
    }

    fn checkText:void (name:string app:BrowserApp want:string) {
        def got:string (this.bodyText(app))
        if (got != want) {
            print ("  " + name + ": got [" + got + "] " + (app.realmStatus()))
        }
        this.check(name (got == want))
    }

    fn file:string (name:string) {
        def c@(optional):string (read_file "vendor/ranger/rangerdom/tests/react" name)
        if (null? c) {
            print ("cannot read " + name)
            return ""
        }
        return (unwrap c)
    }

    fn fieldFor:string (app:BrowserApp sel:string) {
        for app.page.converter.fields f:BrField i {
            if ((strlen f.rd) > 0) {
                if ((this.realm.realm.eval(("String(document.querySelector(" + (DomRealm.quote(sel)) + ").__id)"))) == f.rd) {
                    return f.id
                }
            }
        }
        return ""
    }

    fn basics:void () {
        this.checkText("textContent" (this.open("<p id=a>vanha</p><script>document.getElementById('a').textContent = 'uusi';</script>")) "uusi")
        this.checkText("createElement + appendChild" (this.open("<ul id=l></ul><script>var l = document.getElementById('l'); ['yksi','kaksi'].forEach(function (t) { var li = document.createElement('li'); li.className = 'x'; li.appendChild(document.createTextNode(t)); l.appendChild(li); });</script>")) "yksikaksi")
        this.checkText("innerHTML" (this.open("<div id=r></div><script>document.querySelector('#r').innerHTML = '<b>lihava</b> ja <i>vino</i>';</script>")) "lihava ja vino")
        def a4:BrowserApp (this.open("<div class='a b'>x</div><script>var d = document.querySelector('div.a'); d.classList.remove('a'); d.classList.add('c'); d.style.color = 'red';</script>"))
        def div4@(optional):HNode (a4.page.doc.find("div"))
        def dv:HNode (unwrap div4)
        this.check("classList" ((dv.attr("class")) == "b c"))
        this.check("style" ((indexOf (dv.attr("style")) "red") >= 0))
        this.checkText("an error ends one script only" (this.open("<p id=x>a</p><script>throw new Error('boom');</script><script>document.getElementById('x').textContent = 'b';</script>")) "b")
        def a6:BrowserApp (this.open("<p id=x>a</p><script>setTimeout(function () { document.getElementById('x').textContent = 'myöhemmin'; }, 100);</script>"))
        this.checkText("timer not yet" a6 "a")
        a6.tick(60.0)
        this.drive(a6)
        this.checkText("timer still not" a6 "a")
        a6.tick(60.0)
        this.drive(a6)
        this.checkText("timer after 120 ms" a6 "myöhemmin")
    }

    ; fetch goes through the browser, under its allowlist
    fn fetching:void () {
        def app:BrowserApp (this.open("<p id=x>a</p><script>fetch('/data.json').then(function (r) { return r.json(); }).then(function (j) { document.getElementById('x').textContent = j.v; }); fetch('https://evil.example/').then(function () {}, function () { document.body.setAttribute('data-refused', '1'); });</script>"))
        def r:[string] (this.nextReq(app))
        this.check("fetch: requested by the browser" (((itemAt r 1) == "data") && ((itemAt r 2) == "https://example.com/data.json")))
        app.deliver((this.reqId(r)) 200 "https://example.com/data.json" "application/json" "{\"v\":\"palvelimelta\"}")
        this.drive(app)
        this.checkText("fetch: answer reaches the page" app "palvelimelta")
        def body@(optional):HNode (app.page.doc.find("body"))
        this.check("fetch: a host off the list is refused" (((unwrap body).attr("data-refused")) == "1"))
    }

    fn react:void () {
        def html:string "<html><head><title>React</title><script src=\"react.js\"></script><script src=\"react-dom.js\"></script></head><body><div id=\"root\"><noscript>JavaScript tarvitaan</noscript></div><script src=\"app.js\"></script></body></html>"
        def app (new BrowserApp())
        app.setPageSize(900.0 700.0)
        app.navigate("https://example.com/a/")
        def r:[string] (this.nextReq(app))
        app.deliver((this.reqId(r)) 200 "https://example.com/a/" "text/html" html)
        def code:string ""
        code = (code + "var h = React.createElement;\n")
        code = (code + "function App() {\n")
        code = (code + "  var c = React.useState(0), t = React.useState('');\n")
        code = (code + "  return h('div', null,\n")
        code = (code + "    h('h1', null, 'Laskuri'),\n")
        code = (code + "    h('button', { id: 'inc', onClick: function () { c[1](c[0] + 1); } }, 'Painettu ' + c[0]),\n")
        code = (code + "    h('div', { id: 'card', onClick: function () { c[1](10); } }, h('span', null, 'Kortti')),\n")
        code = (code + "    h('input', { id: 'name', value: t[0], onChange: function (ev) { t[1](ev.target.value.toUpperCase()); } }),\n")
        code = (code + "    h('p', { id: 'out' }, 'Hei ' + t[0]),\n")
        code = (code + "    h('a', { href: '/toinen' }, 'Toinen sivu'));\n")
        code = (code + "}\n")
        code = (code + "ReactDOM.createRoot(document.getElementById('root')).render(h(App));\n")
        def i:int 0
        while (i < 3) {
            def sr:[string] (this.nextReq(app))
            def u:string (itemAt sr 2)
            def text:string code
            if (endsWith u "/react.js") {
                text = (this.file("react.production.min.js"))
            }
            if (endsWith u "/react-dom.js") {
                text = (this.file("react-dom.production.min.js"))
            }
            app.deliver((this.reqId(sr)) 200 u "text/javascript" text)
            i = (i + 1)
        }
        this.drive(app)
        this.check("react: realm live" ((startsWith (app.realmStatus()) "live scripts=3 failed=0")))
        if ((startsWith (app.realmStatus()) "live scripts=3 failed=0") == false) {
            print ("  " + (app.realmStatus()))
        }
        this.checkText("react: rendered" app "LaskuriPainettu 0KorttiHei Toinen sivu")
        ; the button is a field of the browser's; a press goes to the page
        def inc:string (this.fieldFor(app "#inc"))
        this.check("react: the button is a target" ((strlen inc) > 0))
        app.press(inc)
        this.drive(app)
        this.checkText("react: a click on the button" app "LaskuriPainettu 1KorttiHei Toinen sivu")
        ; a plain element's handler: the text inside it is the target
        def spanRd:string (this.realm.realm.eval("String(document.querySelector('#card span').__id)"))
        app.press(("J" + spanRd))
        this.drive(app)
        this.checkText("react: a click bubbles to a div's onClick" app "LaskuriPainettu 10KorttiHei Toinen sivu")
        ; typing in a controlled field
        def nameId:string (this.fieldFor(app "#name"))
        app.setFocus(nameId)
        app.setFieldValue(nameId "ada")
        this.drive(app)
        this.checkText("react: a controlled field" app "LaskuriPainettu 10KorttiHei ADAToinen sivu")
        this.check("react: the field shows the page's value" ((app.fieldValue(nameId)) == "ADA"))
        this.check("react: the field keeps the focus" ((app.focusedField()) == nameId))
        ; a link: the page lets it through, so the browser goes there
        def lid:string (app.linkIdFor("https://example.com/toinen"))
        app.press(lid)
        this.drive(app)
        def nav:[string] (this.nextReq(app))
        this.check("react: a link goes through the page to the browser" (((itemAt nav 1) == "page") && ((itemAt nav 2) == "https://example.com/toinen")))
    }

    sfn main:void () {
        def c (new RealmCheck())
        c.run()
    }

    fn run:void () {
        this.basics()
        this.fetching()
        this.react()
        print ("realm: passed " + (to_string passes) + ", failed " + (to_string fails))
    }
}
