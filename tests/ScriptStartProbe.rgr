; SPDX-License-Identifier: AGPL-3.0-or-later
; A saved page's scripts started as the browser starts them, every request
; answered from disk: the probe for timing script start-up.
;   npx rgrc -es6 tests/ScriptStartProbe.rgr -d=build -o=start_probe.cjs -nodecli
;   node build/start_probe.cjs <dir with index.html, urls.tsv, res/> <url>
; urls.tsv: url, local path, status, content type (tab separated).
; Any host may be opened (no allowlist); trackers are still refused. After
; the start it runs 60 s of page time, with a wheel turn at 20 s.
Import "../src/js/PageRealm.rgr"
Import "../src/BrowserApp.rgr"

class ScriptStartProbe {
    def realm:PageRealm (new PageRealm())
    def urls:[string]
    def paths:[string]
    def types:[string]
    def dir:string ""

    fn drive:void (app:BrowserApp) {
        def guard:int 0
        while ((app.realmJobPending()) && (guard < 50)) {
            def job:int (app.takeRealmJob())
            if (app.realmRequestIsStart()) {
                realm = (new PageRealm())
            }
            def req:string (app.realmRequest())
            print ("  realm request " + (to_string (strlen req)) + " bytes")
            def ans:string (realm.handle(req))
            print ("  realm answered " + (to_string (strlen ans)) + " bytes")
            app.realmResult(job ans)
            print ("  host took it: " + (app.realmStatus()) + " page at " + (to_string (app.domScrollTop())))
            guard = (guard + 1)
        }
    }

    fn answer:boolean (app:BrowserApp) {
        def r:string (app.nextRequest())
        if ((strlen r) == 0) {
            return false
        }
        def p:[string] (strsplit r "\t")
        def id:int (unwrap (str2int (itemAt p 0)))
        def kind:string (itemAt p 1)
        def u:string (itemAt p 2)
        if (kind == "image") {
            app.deliver(id 404 u "text/plain" "")
            return true
        }
        def i:int 0
        while (i < (array_length urls)) {
            if ((itemAt urls i) == u) {
                def body@(optional):string (read_file dir (itemAt paths i))
                if (!null? body) {
                    print ("  " + kind + " " + u)
                    app.deliver(id 200 u (itemAt types i) (unwrap body))
                    return true
                }
            }
            i = (i + 1)
        }
        print ("  missing " + kind + " " + u)
        app.deliver(id 404 u "text/plain" "")
        return true
    }

    sfn main:void () {
        def p (new ScriptStartProbe())
        p.run((shell_arg 0) (shell_arg 1))
    }

    fn run:void (d:string url:string) {
        dir = d
        def tsv@(optional):string (read_file dir "urls.tsv")
        if (!null? tsv) {
            def lines:[string] (strsplit (unwrap tsv) "\n")
            for lines line:string k {
                def f:[string] (strsplit line "\t")
                ; (a redirect saved without a body has no path)
                if (((array_length f) >= 4) && ((strlen (itemAt f 1)) > 0)) {
                    push urls (itemAt f 0)
                    push paths (itemAt f 1)
                    push types (itemAt f 3)
                }
            }
        }
        def html@(optional):string (read_file dir "index.html")
        def app (new BrowserApp())
        app.policy.enforce = false
        app.setPageSize(1100.0 800.0)
        app.navigate(url)
        def r:[string] (strsplit (app.nextRequest()) "\t")
        print "page"
        app.deliver((unwrap (str2int (itemAt r 0))) 200 url "text/html" (unwrap html))
        this.drive(app)
        def rounds:int 0
        while (rounds < 6) {
            while (this.answer(app)) {
            }
            this.drive(app)
            print ("round " + (to_string rounds) + ": " + (app.realmStatus()))
            app.tick(16.0)
            this.drive(app)
            rounds = (rounds + 1)
        }
        print ("status: " + (app.realmStatus()))
        def simMs:double 0.0
        def wheeled:boolean false
        while (simMs < 60000.0) {
            while (this.answer(app)) {
            }
            app.tick(100.0)
            simMs = (simMs + 100.0)
            if ((simMs >= 20000.0) && (wheeled == false)) {
                wheeled = true
                print "wheel"
                app.wheel(300.0)
                print ("  page at " + (to_string (app.domScrollTop())))
            }
            if (app.realmJobPending()) {
                print ("sim " + (to_string simMs))
                this.drive(app)
            }
        }
        def ei:int 0
        while (ei < (app.realmErrorCount())) {
            print ("error: " + (app.realmErrorAt(ei)))
            ei = (ei + 1)
        }
        for realm.realm.errors re:string rei {
            print ("realm error: " + re)
        }
        def li:int 0
        while (li < (app.realmLogCount())) {
            print ("log: " + (app.realmLogAt(li)))
            li = (li + 1)
        }
    }
}
