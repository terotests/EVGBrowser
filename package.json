{
  "name": "evg-browser",
  "version": "0.1.0",
  "private": true,
  "description": "A safe, child-friendly web browser written in Ranger on the EVG layout engine",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "check": "node tools/check.mjs",
    "check:cpp": "node tools/check.mjs --cpp",
    "build": "node web/build.mjs",
    "serve": "node web/build.mjs && node tools/serve.mjs",
    "sdl": "native/sdl/build.sh",
    "sdl:run": "native/sdl/build.sh && build/evg-browser",
    "postinstall": "rgrc install -vendor",
    "deps": "rgrc install -vendor"
  },
  "devDependencies": {
    "ranger-compiler": "4.0.0"
  }
}
