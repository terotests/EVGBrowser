; ==============================================================================
; BrImageMeasurer — the pictures' own sizes, for the layout.
; ==============================================================================
;
; EVGLayout keeps an image's shape when only its width is given, if it can ask
; how big the picture is. The host reports each picture's natural size as it
; decodes it (`BrowserApp.imageLoaded`); this answers the layout from those
; reports, so `<img style="width: 100%">` is as tall as it should be in a
; column of any width.
; ==============================================================================

Import "pkg:evg/EVGImageMeasurer.rgr"
Import "HtmlToEvg.rgr"

class BrImageMeasurer extends EVGImageMeasurer {
    def images:[string:BrImage]

    Constructor () {
        def m:[string:BrImage]
        images = m
    }

    fn getImageDimensions:EVGImageDimensions (src:string) {
        if (has images src) {
            def im:BrImage (unwrap (get images src))
            if (im.known && ((im.failed == false) && ((im.width > 0.0) && (im.height > 0.0)))) {
                return (EVGImageDimensions.create((to_int im.width) (to_int im.height)))
            }
        }
        def none (new EVGImageDimensions())
        return none
    }
}
