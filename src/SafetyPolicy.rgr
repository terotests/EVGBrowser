; SPDX-License-Identifier: AGPL-3.0-or-later
; ==============================================================================
; SafetyPolicy — where this browser may go, and what it will show there.
; ==============================================================================
;
; The browser is meant for children, so the policy is an ALLOWLIST: a page is
; loaded only from a host on the list (or a subdomain of one). Everything
; else is answered with the browser's own "not allowed" page, which says
; which address was refused, so a parent can add it if they want to.
;
; What the engine never does, whatever the list says, is not policy but
; design, and lives in the converter: no scripts are run, no video, audio,
; iframes, plugins or canvases are shown, forms are submitted only with GET
; (a search box works, a login form does not), and nothing is ever
; positioned over the page (`position: fixed` and `absolute` are ignored),
; so a page cannot put up a pop-up.
;
; The list is data. A host may replace it (`setAllowed`) from a parent's
; settings; `defaults` is what ships.
; ==============================================================================

Import "BrUrl.rgr"

class SafetyPolicy {
    def allowed:[string]
    ; false turns the allowlist off (an "open" mode for grown-ups); the
    ; engine's own restrictions stay on
    def enforce:boolean true
    def maxPageBytes:int 4000000
    def maxCssBytes:int 1500000
    def maxStylesheets:int 32
    def showImages:boolean true
    ; Page scripts run in a realm of their own, with no network and no way
    ; to open anything themselves: a link they follow and a fetch they make
    ; come to the browser, which applies this policy to them.
    def runScripts:boolean true
    ; pages are drawn by the realm (RangerDOM) once their styles are here,
    ; with or without scripts; the host turns it off when it has no realm
    def domRender:boolean true
    ; Advertising, tracking and consent-banner services: their scripts are
    ; not run and the page's requests to them are refused, as for a page off
    ; the list. On a page like tori.fi's they are most of the script there is
    ; (14 of 17 seconds in the realm), and none of it is the page.
    def blockTrackers:boolean true
    def trackers:[string]
    def maxScripts:int 30
    def maxScriptBytes:int 2000000

    Constructor () {
        def a:[string]
        allowed = a
        def tr:[string]
        trackers = tr
        this.defaults()
        this.defaultTrackers()
    }

    fn defaultTrackers:void () {
        clear trackers
        ; ads
        push trackers "doubleclick.net"
        push trackers "googlesyndication.com"
        push trackers "googleadservices.com"
        push trackers "googletagservices.com"
        push trackers "adservice.google.com"
        push trackers "amazon-adsystem.com"
        push trackers "adnxs.com"
        push trackers "adform.net"
        push trackers "criteo.com"
        push trackers "criteo.net"
        push trackers "rubiconproject.com"
        push trackers "pubmatic.com"
        push trackers "openx.net"
        push trackers "casalemedia.com"
        push trackers "smartadserver.com"
        push trackers "teads.tv"
        push trackers "taboola.com"
        push trackers "outbrain.com"
        push trackers "adnami.io"
        push trackers "relevant-digital.com"
        push trackers "id5-sync.com"
        push trackers "liadm.com"
        ; analytics and tracking
        push trackers "googletagmanager.com"
        push trackers "google-analytics.com"
        push trackers "scorecardresearch.com"
        push trackers "facebook.net"
        push trackers "hotjar.com"
        push trackers "chartbeat.com"
        push trackers "cxense.com"
        push trackers "permutive.com"
        push trackers "quantserve.com"
        push trackers "m10s.io"
        ; consent banners for the above
        push trackers "privacy-mgmt.com"
        push trackers "cookielaw.org"
        push trackers "cookiebot.com"
        push trackers "consensu.org"
        push trackers "cmpv2.tori.fi"
    }

    ; Is this one of the advertising or tracking services (`trackers`)?
    fn isTracker:boolean (u:BrUrl) {
        if (blockTrackers == false) {
            return false
        }
        def h:string (to_lowercase u.host)
        for trackers t:string i {
            if ((h == t) || (endsWith h ("." + t))) {
                return true
            }
        }
        return false
    }

    ; May a page's script come from here, or a page's script fetch from
    ; here? Where a page may be loaded from, and not a tracker.
    fn scriptAllowed:boolean (u:BrUrl) {
        if ((this.isTracker(u)) == true) {
            return false
        }
        return (this.pageAllowed(u))
    }

    fn defaults:void () {
        clear allowed
        ; news
        push allowed "yle.fi"
        ; encyclopedias
        push allowed "wikipedia.org"
        push allowed "wikimedia.org"
        push allowed "vikidia.org"
        ; made for children
        push allowed "sieppo.fi"
        push allowed "luontolive.fi"
        push allowed "oppijailo.fi"
        ; libraries, museums, science for children
        push allowed "kirjastot.fi"
        push allowed "luontoportti.com"
        push allowed "tiedekeskus.fi"
        push allowed "heureka.fi"
        push allowed "korkeasaari.fi"
        push allowed "nasa.gov"
        push allowed "esa.int"
        push allowed "bbc.co.uk"
        push allowed "natgeokids.com"
        ; small, plain pages that are good for testing
        push allowed "example.com"
        push allowed "info.cern.ch"
        push allowed "terotests.github.io"
    }

    fn setAllowed:void (list:[string]) {
        clear allowed
        for list h:string i {
            def t:string (to_lowercase (trim h))
            if ((strlen t) > 0) {
                push allowed t
            }
        }
    }

    ; A comma or newline separated list, as a settings field holds it.
    fn setAllowedText:void (text:string) {
        def items:[string] (strsplit (replace text "\n" ",") ",")
        this.setAllowed(items)
    }

    fn allowedText:string () {
        return (join allowed ", ")
    }

    fn hostAllowed:boolean (host:string) {
        if (enforce == false) {
            return true
        }
        def h:string (to_lowercase host)
        for allowed a:string i {
            if (h == a) {
                return true
            }
            if (endsWith h ("." + a)) {
                return true
            }
        }
        return false
    }

    ; May a page at this URL be loaded? `about:` pages always may.
    fn pageAllowed:boolean (u:BrUrl) {
        if (u.isAbout()) {
            return true
        }
        if ((u.isWeb()) == false) {
            return false
        }
        return (this.hostAllowed(u.host))
    }

    ; Why not, in words for the "not allowed" page.
    fn reasonFor:string (u:BrUrl) {
        if ((u.isWeb()) == false) {
            if ((strlen u.scheme) > 0) {
                return ("Osoitteet, jotka alkavat \"" + u.scheme + ":\", eivät toimi tässä selaimessa.")
            }
            return "Tämä ei näytä verkko-osoitteelta."
        }
        return ("Sivusto " + u.host + " ei ole sallittujen sivustojen listalla.")
    }

    ; Images are fetched from wherever an allowed page points (news photos
    ; come from a CDN on another host); they can be switched off entirely.
    fn imageAllowed:boolean (u:BrUrl) {
        if (showImages == false) {
            return false
        }
        if (u.scheme == "data") {
            return true
        }
        return (u.isWeb())
    }
}
